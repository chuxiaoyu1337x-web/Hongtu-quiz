.practice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 2rpx 14rpx;
}

.practice-title {
  font-size: 29rpx;
  font-weight: 650;
}

.practice-count {
  color: #71645d;
  font-size: 26rpx;
}

.progress-track {
  overflow: hidden;
  height: 9rpx;
  border-radius: 20rpx;
  background: #eadfd7;
}

.progress-value {
  height: 100%;
  border-radius: 20rpx;
  background: #9b3842;
}

.question {
  margin: 32rpx 0 26rpx;
  padding: 30rpx;
  border: 2rpx solid #eee4dc;
  border-radius: 24rpx;
  background: #fff;
}

.question-type {
  color: #852a33;
  font-size: 25rpx;
  font-weight: 600;
}

.question-stem {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.options {
  margin-bottom: 26rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-height: 98rpx;
  margin: 0 0 14rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #e9dfd6;
  border-radius: 20rpx;
  background: #fff;
  text-align: left;
}

.option[disabled] {
  background: #fff;
  color: #28211e;
}

.option-key {
  flex: 0 0 52rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #f3eee8;
  color: #51443d;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 52rpx;
  text-align: center;
}

.option-content {
  flex: 1;
  min-width: 0;
  align-self: center;
}

.option-text {
  color: #28211e;
  font-size: 30rpx;
  line-height: 1.47;
  overflow-wrap: break-word;
}

.option-note {
  margin-top: 6rpx;
  color: #852a33;
  font-size: 23rpx;
  font-weight: 600;
}

.option-selected,
.option-pressed {
  border-color: #bd7880;
  background: #fbefee;
}

.option-selected .option-key {
  background: #852a33;
  color: #fff;
}

.option-correct[disabled] {
  border-color: #80ad96;
  background: #eaf5ee;
}

.option-correct .option-key {
  background: #226242;
  color: #fff;
}

.option-correct .option-note {
  color: #226242;
}

.option-incorrect[disabled] {
  border-color: #c98083;
  background: #faeeec;
}

.option-incorrect .option-key {
  background: #852a33;
  color: #fff;
}

.feedback {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.feedback-correct {
  background: #e7f3eb;
  color: #205d3e;
}

.feedback-incorrect {
  background: #f9e8e6;
  color: #7b2a2e;
}

.feedback-status {
  margin-right: 20rpx;
  font-weight: 700;
}

.summary {
  margin: 16rpx 0 30rpx;
  padding: 56rpx 32rpx;
  border: 2rpx solid #ece3da;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
}

.summary-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.summary-score {
  margin: 20rpx 0 6rpx;
  color: #852a33;
  font-size: 68rpx;
  font-weight: 700;
}

.summary-context {
  color: #71645d;
  font-size: 26rpx;
}

.repeat {
  margin-top: 16rpx;
}
