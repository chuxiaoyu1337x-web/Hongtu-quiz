page {
  background: #f7f5f1;
  color: #28211e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 0;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

.page-content {
  box-sizing: border-box;
  max-width: 800rpx;
  margin: 0 auto;
  padding: 22rpx 32rpx 56rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.primary-button {
  background: #852a33;
  color: #fff;
}

.primary-button[disabled] {
  background: #ebe5df;
  color: #736862;
}

.secondary-button {
  background: #fff;
  border: 2rpx solid #ece3da;
  color: #752830;
}

.button-pressed {
  opacity: .78;
}
